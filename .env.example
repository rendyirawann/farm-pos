APP_NAME="Mooda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

# Verifikasi Google Search Console — HANYA untuk metode "Tag HTML" (properti Awalan URL).
# Untuk properti "Domain" (verifikasi via DNS TXT) ini TIDAK diperlukan. Isi token-nya saja
# (tanpa awalan "google-site-verification=").
GOOGLE_SITE_VERIFICATION=

# ID Aplikasi Facebook (opsional) — hanya untuk menghilangkan warning "fb:app_id" di
# Facebook Sharing Debugger / Domain Insights. Preview link WhatsApp/FB tetap jalan tanpa ini.
FACEBOOK_APP_ID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stakko_pos
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Midtrans (dipakai untuk pembayaran LANGGANAN/billing SaaS, bukan POS)
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Opsional: override URL notifikasi Midtrans. Kosongkan utk pakai setelan dashboard Midtrans.
MIDTRANS_NOTIFY_URL=

# Aplikasi tablet (APK). Kosongkan jika file APK ditaruh di public/downloads/stakko-pos.apk
MOBILE_APK_URL=
MOBILE_APK_VERSION=1.0.0
SUPPORT_WA=6282362211676

# Realtime (Laravel Reverb) — opsional
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http
